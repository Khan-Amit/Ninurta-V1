name: Build APK

on:
  push:
    tags:
      - 'v*'

jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4

      - name: Set up JDK 17
        uses: actions/setup-java@v3
        with:
          java-version: '17'
          distribution: 'temurin'

      - name: Setup Android SDK
        uses: android-actions/setup-android@v3

      - name: Install Rust
        uses: dtolnay/rust-toolchain@stable
        with:
          targets: aarch64-linux-android, armv7-linux-androideabi

      - name: Build Rust library for Android
        run: |
          cargo install cargo-ndk
          cd core
          cargo ndk --target aarch64-linux-android --target armv7-linux-androideabi build --release
          mkdir -p ../app/src/main/jniLibs/arm64-v8a ../app/src/main/jniLibs/armeabi-v7a
          cp target/aarch64-linux-android/release/libninurta.so ../app/src/main/jniLibs/arm64-v8a/
          cp target/armv7-linux-androideabi/release/libninurta.so ../app/src/main/jniLibs/armeabi-v7a/

      - name: Build APK
        run: |
          cd android
          chmod +x gradlew
          ./gradlew assembleRelease

      - name: Create Release and Upload APK
        uses: softprops/action-gh-release@v1
        with:
          files: android/app/build/outputs/apk/release/app-release.apk
          name: Ninurta-V1 ${{ github.ref_name }}
          body: |
            Direct install APK for Ninurta-V1.
            Download and tap to install.
